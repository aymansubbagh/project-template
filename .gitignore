# Data never goes in Git: download it with scripts/get_data.sh instead
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Generated results (regenerate with one command)
results/*
!results/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Large scientific formats (safety net)
*.bam
*.fastq
*.fastq.gz
*.h5ad
*.nwb
*.edf

# OS / editors
.DS_Store
.vscode/
.idea/

# Secrets
.env
